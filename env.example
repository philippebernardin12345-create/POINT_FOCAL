# ============================================================
# POINT FOCAL V10.4 - VARIABLES D'ENVIRONNEMENT
# ============================================================
# 
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# ─── PORT ──────────────────────────────────────────────────────────────
PORT=5000

# ─── BASE DE DONNÉES ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/point_focal

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_SECRET_KEY_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# ─── BLOCKCHAIN (BNB Chain) ──────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org/
USDT_BEP20_CONTRACT=0x55d398326f99059ff775485246999027b3197955

# ─── EMAIL (Brevo) ────────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
SMTP_FROM=noreply@pointfocal.com

# ─── AWS S3 (Storage) ─────────────────────────────────────────────────
AWS_REGION=eu-west-3
S3_BUCKET=point-focal-uploads
S3_PRESIGN_EXPIRES=300
S3_UPLOAD_PREFIX=uploads/

# ─── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://pointfocal.com

# ─── ADMIN ────────────────────────────────────────────────────────────
ADMIN_TEMP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ─── ENVIRONNEMENT ────────────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV=production

# ─── LOGGING ──────────────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_LEVEL=debug

# ─── ANTIFRAUDE ──────────────────────────────────────────────────────
# En développement, vous pouvez désactiver l'antifraude
SKIP_ANTIFRAUD=false